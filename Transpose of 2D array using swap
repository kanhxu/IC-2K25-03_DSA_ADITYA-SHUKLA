#include <iostream>
using namespace std;


int main(){
int matrix[3][3]={{2,3,6},{5,6,4},{7,8,9}};
//1. Must be a square matrix 
//int matrix[3][3];
for (int i=0;i<3;i++){
    for (int j=i;j<3;j++){
        swap(matrix[i][j],matrix[j][i]);
        
    }
}
cout<<"------transpose matrix-----"<<endl;
for(int i=0;i<3;i++){
    for (int j=0;j<3;j++){
        cout<<matrix[i][j]<<" ";
    }
    cout<<endl;
}
return 0;

}
